{
  "permissions": {
    "allow": [
      "Read(~/.claude/**)",
      "Read(~/Projects/{dse,claude-gen,pstar,pstar_meta,pstar_ref,sysand_index,syside}/**)",
      "Write(~/Projects/{dse,claude-gen,pstar,pstar_meta,pstar_ref,sysand_index,syside}/**)",
      "Bash(gh *)",
      "Bash(curl *)",
      "WebFetch"
    ],
    "deny": [
      "Read(~/**)",
      "Write(~/**)",
      "Read(**/.env)",
      "Read(**/.envrc)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_HOME}}/hooks/warn-sensitive-files.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_HOME}}/read-once/hook.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash {{CLAUDE_HOME}}/statusline-command.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "cq@cq": true
  },
  "extraKnownMarketplaces": {
    "cq": {
      "source": {
        "source": "github",
        "repo": "mozilla-ai/cq"
      }
    }
  },
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_BUG_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  }
}
